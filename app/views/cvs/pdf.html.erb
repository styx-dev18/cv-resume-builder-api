<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title><%= @cv.title.presence || "CV" %></title>
<style>
<%== @font_faces_css %>

:root {
  --fg: #0a0a0a;
  --muted: #737373;
  --border: #1f2937;
  --bg: #ffffff;
}

* , *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

@page { size: A4; margin: 20mm 18mm; }

html { font-size: 16px; }

body {
  font-family: 'Open Sans', Arial, sans-serif;
  font-size: 0.875rem;
  line-height: 1.25rem;
  color: var(--fg);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
}

a { color: inherit; text-decoration: none; }
ol, ul { list-style: none; }
p { margin: 0; }

.cv { display: flex; flex-direction: column; }

.section { display: flex; flex-direction: column; padding: 0.5rem 0; }
.section-gap-1 { gap: 0.25rem; }
.section-gap-2 { gap: 0.5rem; }
.section-gap-3 { gap: 0.75rem; }

.section-title {
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.25rem;
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
}

.entry { margin-left: 0.5rem; margin-bottom: 0.25rem; }

.row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.5rem;
}
.row-start {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.5rem;
}

.bold { font-weight: 700; }
.semibold { font-weight: 600; }
.muted { color: var(--muted); }
.external-link svg { width: 0.75rem; height: 0.75rem; vertical-align: middle; }
.shrink-0 { flex-shrink: 0; }
.text-right { text-align: right; }
.text-xs { font-size: 0.75rem; line-height: 1rem; }
.pre-wrap { white-space: pre-wrap; }
.mt-1 { margin-top: 0.25rem; }

.rich-text ol { list-style: decimal; padding-left: 1.25rem; }
.rich-text ul { list-style: disc; padding-left: 1.25rem; }

.personal-info { display: flex; flex-direction: column; align-items: center; text-align: center; }
.personal-info .name { font-size: 1.875rem; line-height: 2.25rem; font-weight: 700; text-transform: uppercase; }
.info-row {
  margin-top: 0.25rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  column-gap: 0.375rem;
  font-size: 0.875rem;
  color: var(--muted);
}
.info-row .dot { margin-right: 0.375rem; }
</style>
</head>
<body>
  <div class="cv">
    <% @cv.cv_sections.each do |section| %>
      <% items = section.cv_section_items.map(&:as_json_fields) %>
      <%= render partial: "cvs/pdf_sections/#{section.section_type.underscore}",
                 locals: { title: section.title, items: items } %>
    <% end %>
  </div>
</body>
</html>
